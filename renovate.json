{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mike12806/renovate-config"
  ],
  "automerge": true,
  "ignoreTests": true,
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "TrueNAS api_client commit pin in the NFS updater workflow (not on PyPI, installed from git)",
      "managerFilePatterns": [
        ".github/workflows/nfs-ip-security-list-updater.yml"
      ],
      "matchStrings": [
        "TRUENAS_API_CLIENT_REF=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "truenas/api_client",
      "packageNameTemplate": "https://github.com/truenas/api_client",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "websocket-client version pin in the NFS updater workflow",
      "managerFilePatterns": [
        ".github/workflows/nfs-ip-security-list-updater.yml"
      ],
      "matchStrings": [
        "WEBSOCKET_CLIENT_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "websocket-client",
      "datasourceTemplate": "pypi"
    }
  ]
}
